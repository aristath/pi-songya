{
  "name": "pi-songya",
  "version": "0.1.0",
  "description": "Direct Songya memory tools and automatic recall for Pi",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "memory",
    "songya"
  ],
  "files": [
    "src",
    "native/main.go",
    "native/go.mod",
    "native/go.sum",
    "scripts/build.mjs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:native": "cd native && go test -race ./...",
    "check": "npm run typecheck && npm test && npm run test:native",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "typebox": "1.3.27"
  }
}
